# Copy to .env and adjust. Never commit .env (only this example file).
# Rule: services reach each other by Docker service NAME, never localhost or a LAN IP.

# --- Host-published ports (only the gateway should really be public) ---
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
KEYCLOAK_HOST_PORT=8080

# --- Internal service URLs (Docker DNS names) ---
KEYCLOAK_URL=http://keycloak:8080
OPA_URL=http://opa:8181
AUTHORIZATION_API_URL=http://authorization-api:8000
EMPLOYEE_PORTAL_URL=http://employee-portal:8001
DEVELOPER_API_URL=http://developer-api:8002
ADMIN_PANEL_URL=http://admin-panel:8003

# --- PostgreSQL (not published to the host) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ztna
POSTGRES_USER=ztna_user
POSTGRES_PASSWORD=change_me

# --- Keycloak admin (lab only) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me

# --- Conventions ---
LOG_LEVEL=info
TZ=UTC
